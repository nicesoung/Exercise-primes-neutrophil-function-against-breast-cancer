msigdb.files = msigdb.files[-grep("MERGE", msigdb.files)]
for(x in 1:length(msigdb.files)) {
  msigdb.file = msigdb.files[x]
  msigdb.dir = dirname(msigdb.file)
  tmp.smoking = basename(dirname(msigdb.dir))
  tmp.case = strsplit(basename(msigdb.file), "\\.")[[1]][2]
  if(tmp.case == "DOWN") {
    tmp.case = "Down"
    tmp.color = "#A1CAFF"
  }
  if(tmp.case == "UP") {
    tmp.case = "Up"
    tmp.color = "#FFA1A1"
  }
  marker.file = paste0(dirname(msigdb.dir), "/marker.txt")
  marker.df = read.delim(marker.file, header = T, as.is = T)
  msigdb.df = read.delim(msigdb.file, header = T, as.is = T)
  msigdb.df = msigdb.df[order(msigdb.df$P.value, decreasing = F),]
  sig.df = subset(msigdb.df, P.value < 0.05)
  if(nrow(sig.df) == 0) {
    next
  }
  plot.df = sig.df[1:5,c("P.value", "Term")]
  for(i in 1:5) {
    tmp.genes = strsplit(sig.df[i,"Genes"], ";")[[1]]
    tmp.fc = abs(marker.df[tmp.genes,"avg_log2FC"])
    tmp.top.genes = tmp.genes[order(tmp.fc, decreasing = T)[1:7]]
    b.array = which(is.na(tmp.top.genes))
    if(length(b.array) > 0) {
      tmp.top.genes = tmp.top.genes[-b.array]
    }
    plot.df[i,"Gene"] = paste(tmp.top.genes, collapse = ", ")
  }
  plot.df$x_co = c(nrow(plot.df):1)
  plot.df$logP = -log10(plot.df$P.value)
  b.array = which(is.na(plot.df$Term))
  if(length(b.array) > 0) {
    plot.df[b.array,"Term"] = ""
    plot.df[b.array,"logP"] = 0
  }
  out.file = paste0(msigdb.dir, "/", tmp.case, "_in_Exercise_group.png")
  cat(out.file, "\n")
  msigdb.plot = ggplot() +
    geom_bar(data = plot.df, aes(x = x_co, y = logP, fill = "A"), stat = 'identity') +
    scale_fill_manual(values = tmp.color) +
    scale_y_continuous(expand = c(0.01, 0)) +
    scale_x_discrete(limits = as.character(c(1:nrow(plot.df))), labels = rev(plot.df$Term)) +
    theme_classic(base_size = 25, base_family = 'sans') +
    geom_text(data = plot.df, aes(x= x_co, y = 0, label = Gene), size = 7, hjust = 0) +
    ylab(expression(-log[10](P~value))) +
    xlab("") +
    theme(legend.position = "none", strip.background = element_blank(), axis.title.y = element_text(), axis.title.x = element_text(), axis.text.y = element_text(), axis.text.x = element_text(),
          plot.title = element_text()) +
    ggtitle(paste0(tmp.case, " in Exercise group")) +
    coord_flip()
  # pdf(out.file, width = 15, height = 5)
  png(out.file, width = 960, height = 480, type="cairo")
  print(msigdb.plot)
  dev.off()
}
