  marker.df$gene = rownames(marker.df)
}
marker.df$logP = -log10(marker.df$p_val)
inf.array = which(marker.df$logP == "Inf")
if(length(inf.array) > 0) {
  marker.df[inf.array,"logP"] = max(marker.df[-inf.array,"logP"])
